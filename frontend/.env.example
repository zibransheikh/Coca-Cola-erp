# Copy to .env.local for local dev overrides, or set as build-time
# environment variables in your Netlify site settings for production.

# Leave UNSET for local dev — vite.config.ts already proxies /api to the
# local backend on :8000, so no value is needed there.
# For a production build, set this to your deployed backend's base URL,
# no trailing slash (e.g. https://api.yourdomain.com).
VITE_API_URL=
