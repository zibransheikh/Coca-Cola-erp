# Copy to .env and fill in. Never commit the real .env (it's gitignored).

# Local dev default matches docker-compose.yml. For production, point this
# at your production Postgres instead (e.g. Supabase's connection string) —
# use a SEPARATE database from local dev, never the same one.
DATABASE_URL=postgresql+psycopg://dms:dms@localhost:5432/dms

# Generate a real one for production, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never reuse the same secret across local dev and production.
JWT_SECRET_KEY=change-me-in-production

# Comma-separated list of origins allowed to call this API (no spaces needed,
# they're trimmed). Local dev only needs the Vite dev server's origin;
# production needs your deployed frontend's actual URL(s) added here.
CORS_ORIGINS=http://localhost:5173
